# ============================================================================
# ARTECI - API de standardisation des dates - exemple de configuration d'env
# Copiez ce fichier en `.env` et ajustez. TOUTE la config passe par des variables
# d'environnement, pour que l'image reste immuable et l'API stateless (12-factor).
#
# IMPORTANT : `--env-file` de Docker ne gère PAS les commentaires en fin de ligne ni
# les guillemets : tout ce qui suit `=` est pris littéralement. Gardez donc chaque
# commentaire sur sa PROPRE ligne et écrivez les valeurs nues (sans guillemets, sans
# texte à la suite). python-dotenv (utilisé en local) accepte aussi ce format.
# ============================================================================

# ---- Serveur API ----
APP_NAME=arteci-date-api
# APP_ENV : local | production
APP_ENV=local
# LOG_LEVEL : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---- Stockage objet MinIO / S3 ----
# host:port SANS le schéma (pas de http://)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# true => HTTPS/TLS
MINIO_SECURE=false
# optionnel, laissez vide si non utilisé
MINIO_REGION=

# ---- Réglages du traitement CSV ----
# Plafond strict de lignes renvoyées en aperçu (règle métier = 100).
PREVIEW_ROWS=100
# Force le séparateur. Laissez vide pour AUTO-DÉTECTER depuis l'en-tête (; , \t |).
CSV_SEPARATOR=
# Lignes par batch. Un seul batch est en mémoire à la fois => RAM bornée.
# Baissez pour réduire la RAM pic ; augmentez pour un peu plus de vitesse.
PROCESSING_BATCH_ROWS=500000

# ---- Données de test (pytest + benchmark) ----
# Où vivent les vrais CSV ARTECI (dossier contenant lst_of_users_anon_1.csv ...).
TEST_DATA_DIR=./tests/data

# ---- OpenTelemetry / SigNoz ----
OTEL_ENABLED=true
OTEL_SERVICE_NAME=arteci-date-api
# Collector OTLP de SigNoz. Port gRPC par défaut 4317, HTTP 4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL : grpc | http/protobuf
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_INSECURE=true
# Attributs de ressource libres transmis à SigNoz.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=arteci
